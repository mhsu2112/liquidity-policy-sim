# Secrets: never saved to history or GitHub
.env

# Python working files
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Generated outputs (rebuilt with `make results`); keep the folder itself
outputs/*
!outputs/.gitkeep

# Jev audit log may contain long text; kept locally, summarized in reports
signals/audit_log.jsonl

# Mac clutter
.DS_Store

# Calibration corpus working files (page-reading progress); rebuilt by make corpus
signals/corpus/work/

# Clarification 20: news and analyst excerpts never go public; gold-set sheets stay local
signals/corpus/excerpts_private.csv
signals/corpus/trial_examples.md
signals/gold_set/sheets/
signals/corpus/work_round*/
signals/corpus/check/

# Gold set (Clarification 24): labelers' returned files and the ID key stay private until publish-labels
signals/gold_set/incoming/
signals/gold_set/key.csv
